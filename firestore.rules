rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff']
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.expiresAt is timestamp
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function validCustomer(uid) {
      return request.resource.data.keys().hasOnly(['uid','name','email','phone','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','name','email','phone','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
    }
    function validEventEnquiry() {
      return request.resource.data.keys().hasOnly(['customerId','customerName','email','phone','eventType','eventDate','location','brief','guestCount','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','phone','eventType','eventDate','location','brief','status','createdAt','updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.eventType is string && request.resource.data.eventDate is string
        && request.resource.data.location is string && request.resource.data.brief is string
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email is string)
        && (!request.resource.data.keys().hasAny(['guestCount']) || request.resource.data.guestCount is number);
    }
    function validRentalRequest() {
      return request.resource.data.keys().hasOnly(['customerId','customerName','email','phone','items','eventDate','returnDate','deliveryLocation','deliveryRequired','servicingRequirement','notes','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','phone','items','eventDate','returnDate','deliveryLocation','deliveryRequired','notes','status','createdAt','updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string && request.resource.data.customerName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0
        && request.resource.data.items is list && request.resource.data.items.size() > 0
        && request.resource.data.eventDate is string && request.resource.data.returnDate is string
        && request.resource.data.deliveryLocation is string && request.resource.data.deliveryRequired is bool
        && request.resource.data.notes is string && request.resource.data.status == 'new'
        && (!request.resource.data.keys().hasAny(['servicingRequirement']) || request.resource.data.servicingRequirement in ['yes','no','discuss'])
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email is string);
    }
    match /admins/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }
    match /customers/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if owns(uid) && validCustomer(uid);
      allow delete: if isAdmin();
    }
    match /eventEnquiries/{id} {
      allow create: if signedIn() && validEventEnquiry();
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /rentalRequests/{id} {
      allow create: if signedIn() && validRentalRequest();
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /equipment/{id} {
      allow read, write: if isAdmin();
    }
    match /jobs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /quotes/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /businessSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
